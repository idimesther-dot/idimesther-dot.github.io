rem;line-height:1.9}.hero-actions{display:flex;align-items:center;gap:30px;margin-top:35px}.button{display:inline-flex;gap:28px;align-items:center;padding:14px 20px;font-size:.78rem;font-weight:700}.button-gold{background:#e8bd32;color:#211812}.button-gold:hover{background:#f3d76c}.text-link{font-size:.78rem;color:#e8e4dc}.hero-art{max-width:480px;width:100%;justify-self:center;position:relative}.art-frame{height:480px;border:1px solid #e8bd324d;position:relative;overflow:hidden;background:linear-gradient(145deg,#34414a,#3a291f 55%,#211812)}.art-frame:before{content:"";position:absolute;inset:12px;border:1px solid #ffffff20}.art-sun{position:absolute;width:180px;height:180px;border-radius:50%;background:linear-gradient(145deg,#f0d2a0,#b7794e);top:95px;left:50%;transform:translateX(-50%);box-shadow:0 0 90px #e8bd3240}.art-horizon{position:absolute;bottom:0;left:0;right:0;height:48%;background:linear-gradient(155deg,transparent 0 18%,#211812 18.3% 100%);clip-path:polygon(0 42%,25% 15%,47% 40%,70% 8%,100% 33%,100% 100%,0 100%)}.art-orbit{position:absolute;border:1px solid #e8bd3266;border-radius:50%;width:330px;height:330px;top:30px;left:50%;transform:translateX(-50%) rotate(-28deg)}.orbit-two{width:400px;height:250px;top:70px;transform:translateX(-50%) rotate(30deg)}.art-caption{position:absolute;bottom:25px;left:30px;right:30px;display:flex;justify-content:space-between;font-size:.55rem;letter-spacing:.17em;color:#e8d8c3}.vertical-note{position:absolute;right:-34px;top:45%;writing-mode:vertical-rl;font-size:.55rem;letter-spacing:.2em;color:#c9bba7}.hero-bottom{position:absolute;bottom:28px;left:7vw;right:7vw;display:flex;justify-content:space-between;font-size:.56rem;letter-spacing:.16em;color:#b7a994}.section-wrap{padding-left:7vw;padding-right:7vw}.intro-section{display:grid;grid-template-columns:1fr 3fr;padding-top:140px;padding-bottom:145px;background:#fbf8f0;color:#2c2018}.section-index{font-size:.62rem;letter-spacing:.16em;color:#b18a2b;font-weight:700}.intro-content{max-width:900px}.intro-content .eyebrow,.expertise-main .eyebrow,.education-grid .eyebrow{color:#9a7425}.intro-content h2,.expertise-main h2,.education-grid h2{font-size:clamp(2.6rem,4.5vw,4.3rem);margin:20px 0 30px}.intro-content h2 em{color:#9a7425}.intro-columns{display:grid;grid-template-columns:1fr 1fr;gap:45px;color:#6e6258;font-size:.91rem;line-height:1.9}.underlined-link{display:inline-flex;gap:24px;margin-top:25px;padding-bottom:8px;border-bottom:1px solid #9a7425;color:#2c2018;font-size:.78rem;font-weight:700}.work-section{padding:125px 0 130px;background:#2c2018}.section-heading{display:flex;justify-content:space-between;align-items:end;margin:20px 0 45px}.section-heading h2{font-size:clamp(2.8rem,5vw,4.8rem);margin:15px 0 0}.section-aside{max-width:300px;color:#c9bba7;font-size:.83rem;line-height:1.8}.filter-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:27px}.filter{border:1px solid #ffffff30;background:transparent;color:#cbd0d0;padding:9px 17px;font:inherit;font-size:.7rem;cursor:pointer}.filter.active,.filter:hover{background:#e8bd32;border-color:#e8bd32;color:#211812}.project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:38px 24px}.project-card{display:block;min-width:0}.project-card[hidden]{display:none}.project-visual{height:260px;position:relative;overflow:hidden;background:#283a43;display:flex;align-items:center;justify-content:center;isolation:isolate}.project-visual:before,.project-visual:after{content:"";position:absolute;z-index:-1}.project-visual:before{width:230px;height:230px;border:1px solid #ffffff55;border-radius:50%;left:calc(50% - 115px);top:15px}.project-visual:after{inset:0;background:linear-gradient(135deg,#ffffff0b,transparent 55%,#0005)}.visual-number{position:absolute;left:22px;top:18px;font-family:"Playfair Display",serif;font-size:2rem;color:#ffffffa6}.visual-type{position:absolute;left:24px;bottom:20px;font-size:.58rem;letter-spacing:.16em;color:#f4e8d5}.play-mark{font-size:2.4rem;color:#e8bd32;transition:transform .25s}.project-card:hover .play-mark{transform:translate(5px,-5px)}.visual-one{background:linear-gradient(130deg,#382f32,#8b6550 48%,#1c2830)}.visual-two{background:linear-gradient(130deg,#1e3844,#66818a 48%,#25313a)}.visual-three{background:linear-gradient(130deg,#282c3a,#766b61 52%,#171f27)}.visual-four{background:linear-gradient(130deg,#3d252b,#a36f5a 55%,#1d2930)}.visual-five{background:linear-gradient(130deg,#1d3440,#8b806b 50%,#1b252d)}.visual-six{background:linear-gradient(130deg,#3d3830,#8a7656 50%,#1a252b)}.visual-seven{background:linear-gradient(130deg,#302b35,#b17d53 50%,#192831)}.visual-eight{background:linear-gradient(130deg,#1d3038,#6b7b76 50%,#1a252d)}.visual-nine{background:linear-gradient(130deg,#35303c,#987a66 50%,#18242b)}.visual-ten{background:linear-gradient(130deg,#45343a,#bb8e6a 50%,#26323a)}.visual-eleven{background:linear-gradient(130deg,#283a3e,#7e8b7c 50%,#1c2a30)}.visual-twelve{background:linear-gradient(130deg,#38323c,#9b7d69 50%,#1b2930)}.visual-thirteen{background:linear-gradient(130deg,#263b49,#71808b 50%,#1c252e)}.visual-fourteen{background:linear-gradient(130deg,#40323a,#98765d 50%,#18252e)}.visual-fifteen{background:linear-gradient(130deg,#243943,#8b775e 50%,#1b2930)}.visual-sixteen{background:linear-gradient(130deg,#3c3434,#9c826b 50%,#1b2930)}.project-meta{display:flex;justify-content:space-between;gap:12px;align-items:start;padding-top:14px}.project-meta h3{font-family:"Playfair Display",serif;font-size:1.35rem;font-weight:500;margin:0}.project-meta p{font-size:.7rem;color:#8f9da3;margin:4px 0}.project-role{font-size:.62rem;color:#e8bd32;text-align:right;max-width:155px;padding-top:5px}.work-footnote{color:#b7a994;font-size:.7rem;margin-top:40px}.expertise-section{display:grid;grid-template-columns:1fr 3fr;padding-top:130px;padding-bottom:140px;background:#fbf8f0;color:#2c2018}.expertise-main{max-width:920px}.expertise-main h2 em,.education-grid h2 em{color:#9a7425}.skill-list{margin-top:45px;border-top:1px solid #e5dfd2}.skill-list>div{display:grid;grid-template-columns:45px 1.1fr 1fr;gap:20px;align-items:center;padding:21px 0;border-bottom:1px solid #e5dfd2}.skill-list span,.education-list span{font-size:.65rem;color:#9a7425;letter-spacing:.1em}.skill-list h3{font-family:"Playfair Display",serif;font-weight:500;font-size:1.18rem;margin:0}.skill-list p{font-size:.75rem;color:#75695f;margin:0}.software{margin-top:38px}.software span{font-size:.62rem;letter-spacing:.16em;color:#9a7425;font-weight:700}.software p{font-size:.83rem;color:#6e6258}.education-section{padding:120px 0;background:#2c2018}.education-grid{display:grid;grid-template-columns:1fr 2fr;gap:8vw}.education-grid h2{color:#fffdf7}.education-list{border-top:1px solid #ffffff30}.education-list>div{display:grid;grid-template-columns:70px 1fr;column-gap:20px;padding:19px 0;border-bottom:1px solid #ffffff30}.education-list span{grid-row:span 2;padding-top:6px}.education-list h3{font-family:"Playfair Display",serif;font-size:1.2rem;font-weight:500;margin:0}.education-list p{font-size:.75rem;color:#c9bba7;margin:4px 0 0}.contact-section{background:#fbf8f0;color:#2c2018;padding:120px 0 95px}.contact-wrap .eyebrow{color:#9a7425;margin-top:65px}.contact-wrap h2{font-size:clamp(3rem,6vw,5.6rem);margin:15px 0 35px}.contact-wrap h2 em{color:#9a7425}.contact-email{font-family:"Playfair Display",serif;font-size:clamp(1.2rem,2.5vw,2rem);border-bottom:1px solid #9a7425;padding-bottom:8px}.contact-details{display:flex;gap:35px;flex-wrap:wrap;margin-top:55px;color:#6e6258;font-size:.75rem}footer{display:flex;justify-content:space-between;align-items:center;padding:25px 7vw;background:#211812;color:#b7a994;font-size:.62rem;letter-spacing:.08em}footer .wordmark{color:#fffdf7}footer>a:last-child{color:#e8bd32}
@media(max-width:800px){.site-header{height:70px;padding:0 6vw}.menu-toggle{display:block}.nav-links{display:none;position:absolute;top:70px;left:0;right:0;background:#211812;padding:25px 6vw;flex-direction:column;align-items:flex-start;gap:20px;border-bottom:1px solid #ffffff20}.nav-links.open{display:flex}.hero{grid-template-columns:1fr;padding:140px 6vw 90px;gap:55px;min-height:auto}.hero h1{font-size:clamp(3rem,12vw,5rem)}.hero-art{width:82%;justify-self:center}.art-frame{height:380px}.vertical-note{right:-28px}.hero-bottom{left:6vw;right:6vw;font-size:.48rem}.section-wrap{padding-left:6vw;padding-right:6vw}.intro-section,.expertise-section{grid-template-columns:1fr;gap:35px;padding-top:85px;padding-bottom:90px}.section-heading{display:block}.section-aside{margin-top:25px}.project-grid{gap:30px 15px}.project-visual{height:220px}.project-meta{display:block}.project-role{text-align:left;max-width:none}.education-grid{grid-template-columns:1fr;gap:35px}.contact-section{padding:85px 0 70px}footer{padding:22px 6vw;gap:15px;flex-wrap:wrap}footer>span{order:3;width:100%}}
@media(max-width:520px){.hero-actions{align-items:flex-start;flex-direction:column;gap:18px}.hero-art{width:88%}.art-frame{height:320px}.hero-bottom span:nth-child(2){display:none}.intro-columns{grid-template-columns:1fr;gap:12px}.project-grid{grid-template-columns:1fr}.project-visual{height:240px}.skill-list>div{grid-template-columns:28px 1fr;gap:10px}.skill-list p{grid-column:2}.education-list>div{grid-template-columns:55px 1fr}.contact-details{gap:18px;flex-direction:column}.contact-wrap .eyebrow{margin-top:45px}}
